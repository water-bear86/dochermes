{
  "manifest_version": 3,
  "name": "DocHermes Context Extractor",
  "version": "0.1.0",
  "description": "Optional browser-side context extraction for DocHermes.",
  "permissions": ["activeTab", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "DocHermes Context",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
